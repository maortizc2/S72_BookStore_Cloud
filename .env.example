# ============================================================
# Docker Compose / Microservices reference environment
# ============================================================

COMPOSE_PROJECT_NAME=bookstore

NODE_IMAGE=node:24-alpine
NGINX_IMAGE=nginx:1.27-alpine
POSTGRES_IMAGE=postgres:17-alpine
BOOTSTRAP_IMAGE=postgres:17

# ============================================================
# Image publishing
# ============================================================

IMAGE_REGISTRY=local
IMAGE_TAG=8.1.0

# ============================================================
# Published host ports (API Gateway & Microservices)
# ============================================================

GATEWAY_HOST_PORT=8080
GATEWAY_PORT=8080

AUTH_HOST_PORT=5001
AUTH_SERVICE_PORT=5001

BOOKS_HOST_PORT=5002
BOOKS_SERVICE_PORT=5002

ORDERS_HOST_PORT=5003
ORDERS_SERVICE_PORT=5003

AUTH_DB_HOST_PORT=5432
BOOKS_DB_HOST_PORT=5433
ORDERS_DB_HOST_PORT=5434

# ============================================================
# Vite build-time configuration (Cloudflare CDN -> API Gateway)
# ============================================================

VITE_API_BASE_URL=https://api.tudominio.com
VITE_API_PREFIX=/api
VITE_CURRENCY_LOCALE=es-CO
VITE_CURRENCY_CODE=COP

# ============================================================
# Microservices shared configuration
# ============================================================

NODE_ENV=development
API_BASE_PATH=/api
# Allow traffic explicitly from Cloudflare domain and local development
CORS_ORIGINS=https://tudominio.com,https://bookstore.pages.dev,http://localhost:3000,http://localhost:8080

BOOKS_DEFAULT_LIMIT=24
BOOKS_MAX_LIMIT=100
ORDERS_MAX_DISTINCT_ITEMS=100
ORDERS_MAX_QUANTITY_PER_ITEM=1000

# ============================================================
# HTTP proxy awareness (Cloudflare + AWS Load Balancer / Gateway = 2+ hops)
# ============================================================

HTTP_TRUST_PROXY_HOPS=2
HTTP_JSON_BODY_LIMIT=32kb
ACCESS_LOG_ENABLED=true
ACCESS_LOG_EXCLUDE_PATHS=/health
ACCESS_LOG_MAX_FIELD_LENGTH=2048
ACCESS_LOG_REQUEST_ID_HEADER=X-Request-Id
CLICKSTREAM_FILE_ENABLED=true
CLICKSTREAM_FILE_PATH=/usr/src/app/logs/clickstream.log

# ============================================================
# Authentication / instructional session identity
# ============================================================

AUTH_JWT_SECRET=replace_this_local_secret_with_at_least_32_random_characters
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=bookstore-api
AUTH_JWT_AUDIENCE=bookstore-web
AUTH_TOKEN_TTL_SECONDS=28800
AUTH_COOKIE_NAME=bookstore_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_PATH=/api

# ============================================================
# Independent PostgreSQL database connections per microservice
# ============================================================

AUTH_DB_HOST=postgres-auth
AUTH_DB_PORT=5432
AUTH_DB_NAME=bookstore_auth

BOOKS_DB_HOST=postgres-books
BOOKS_DB_PORT=5432
BOOKS_DB_NAME=bookstore_books

ORDERS_DB_HOST=postgres-orders
ORDERS_DB_PORT=5432
ORDERS_DB_NAME=bookstore_orders

# ============================================================
# Administrative identity (local PostgreSQL and bootstrap only)
# ============================================================

DB_ADMIN_USER=bookstore_admin
DB_ADMIN_PASSWORD=change_me_for_local_development

# ============================================================
# Microservices runtime database identity
# ============================================================

APP_DB_USER=bookstore_app
APP_DB_PASSWORD=change_me_for_local_development

# ============================================================
# Data ingestion identity
# ============================================================

INGEST_DB_USER=bookstore_ingest
INGEST_DB_PASSWORD=change_me_for_local_development

# ============================================================
# Database client settings
# ============================================================

DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
