# Mismo origen: Cloudflare Pages reenvia /api/* al balanceador de AWS (functions/api/[[path]].js)
# y en desarrollo Vite lo reenvia a VITE_DEV_API_TARGET.
VITE_API_BASE_URL=/
VITE_API_PREFIX=/api
VITE_DEV_API_TARGET=http://localhost:8080
VITE_DEV_SERVER_PORT=3000
VITE_CURRENCY_LOCALE=es-CO
VITE_CURRENCY_CODE=COP
