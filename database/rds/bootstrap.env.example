# ============================================================
# BookStore Co. - RDS bootstrap configuration (3 Databases)
#
# Copy this file to bootstrap.env and replace placeholders.
# Never commit bootstrap.env to Git.
# ============================================================

# Shared or individual RDS endpoints
DB_HOST=your-rds-endpoint.amazonaws.com
DB_PORT=5432

AUTH_DB_HOST=your-rds-auth-endpoint.amazonaws.com
AUTH_DB_PORT=5432
AUTH_DB_NAME=bookstore_auth

BOOKS_DB_HOST=your-rds-books-endpoint.amazonaws.com
BOOKS_DB_PORT=5432
BOOKS_DB_NAME=bookstore_books

ORDERS_DB_HOST=your-rds-orders-endpoint.amazonaws.com
ORDERS_DB_PORT=5432
ORDERS_DB_NAME=bookstore_orders

DB_ADMIN_USER=bookstore_admin
DB_ADMIN_PASSWORD=CHANGE_ME

APP_DB_USER=bookstore_app
APP_DB_PASSWORD=CHANGE_ME

INGEST_DB_USER=bookstore_ingest
INGEST_DB_PASSWORD=CHANGE_ME

PGSSLMODE=require
